{
  "mcpServers": {
    "code-graph": {
      "args": ["-y", "@sdsrs/code-graph@0.136.0"],
      "command": "npx",
      "type": "stdio"
    },
    "lsmcp": {
      "args": [
        "exec",
        "lsmcp",
        "--bin",
        "node scripts/lsmcp-tsc.mjs",
        "--files",
        "**/*.ts,**/*.tsx,**/*.d.ts"
      ],
      "command": "pnpm",
      "type": "stdio"
    }
  }
}
