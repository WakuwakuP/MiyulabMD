{
  "name": "miyulabmd",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter @miyulabmd/web dev",
    "dev:worker": "pnpm --filter @miyulabmd/worker dev",
    "db:migrate": "pnpm --filter @miyulabmd/worker db:migrate",
    "build": "pnpm -r build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "setup:deploy": "node scripts/setup-deploy.mjs",
    "test": "pnpm -r --if-present test && node --test scripts/setup-deploy/*.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "storybook": "pnpm --filter @miyulabmd/web storybook"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11"
  }
}
