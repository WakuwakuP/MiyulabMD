{
  "name": "miyulabmd",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --filter @miyulabmd/web dev",
    "dev:worker": "pnpm --filter @miyulabmd/worker dev",
    "db:migrate": "pnpm --filter @miyulabmd/worker db:migrate",
    "build": "pnpm -r build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11"
  }
}
