{
  "name": "@miyulabmd/worker",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "deploy": "wrangler deploy -c wrangler.og-fetch.toml && wrangler deploy -c wrangler.diagram-check.toml && wrangler deploy",
    "predev": "node -e \"require('node:fs').mkdirSync('../web/dist', { recursive: true })\"",
    "dev": "node scripts/dev.mjs",
    "test": "node --experimental-strip-types --test src/auth/*.test.ts src/ssr/*.test.ts src/services/*.test.ts src/durable-objects/*.test.ts src/diagram-check/*.test.ts src/mcp/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@miyulabmd/markdown": "workspace:*",
    "@miyulabmd/shared": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1",
    "@plantuml/core": "1.2026.8",
    "agents": "^0.22.0",
    "elysia": "^1.4.7",
    "fast-diff": "^1.3.0",
    "jose": "^6.2.12",
    "lib0": "^0.2.119",
    "mermaid": "12.1.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "wrangler": "^4.149.0"
  }
}
