{
  "name": "@miyulabmd/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "mkdir -p ../web/dist",
    "dev": "wrangler dev -c wrangler.toml -c wrangler.og-fetch.toml",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "deploy": "wrangler deploy -c wrangler.og-fetch.toml && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/ssr/*.test.ts src/services/*.test.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@miyulabmd/markdown": "workspace:*",
    "@miyulabmd/shared": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.22.0",
    "elysia": "^1.4.7",
    "jose": "^6.2.10",
    "lib0": "^0.2.117",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "wrangler": "^4.28.0"
  }
}
